# --- Database / auth / storage (your own Supabase project) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# --- Text model (any OpenAI-compatible endpoint) ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=YOUR_TEXT_MODEL_API_KEY
AI_TEXT_MODEL=gpt-4.1-mini

# --- Video model (optional; used by the 3D step-video feature) ---
AI_VIDEO_BASE_URL=https://api.openai.com/v1
AI_VIDEO_API_KEY=YOUR_VIDEO_MODEL_API_KEY
AI_VIDEO_MODEL=sora-2

# --- Local database migrations (Drizzle) ---
DB_MIGRATION_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
